<UserControl x:Class="AssetEditor.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:gameinfo="clr-namespace:Shared.Core.Services;assembly=Shared.Core"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:local="clr-namespace:AssetEditor.Views.Settings" xmlns:viewmodels="clr-namespace:AssetEditor.ViewModels"
             xmlns:colourpickerbutton="clr-namespace:Shared.Ui.BaseDialogs.ColourPickerButton;assembly=Shared.Ui"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d" >

    <UserControl.Resources>
        <ObjectDataProvider x:Key="GameTypeEnums" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="gameinfo:GameTypeEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <local:SettingsEnumConverter x:Key="SettingsEnumConverter"/>
        <DataTemplate x:Key="SettingsEnumConverterTemplate">
            <TextBlock Text="{Binding Converter={StaticResource SettingsEnumConverter}}"/>
        </DataTemplate>

        <!-- A group's title, with the line under it. -->
        <Style x:Key="GroupTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="5, 12, 0, 0"/>
        </Style>
        <Style x:Key="GroupLine" TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Type Separator}}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="5, 5, 10, 10"/>
        </Style>
    </UserControl.Resources>

    <!-- One label column per tab (only the shown tab is laid out), as wide as its longest label: French runs long. -->
    <TabControl Margin="5, 5, 5, 0" Grid.IsSharedSizeScope="True">
        <TabItem Header="{loc:Loc SettingsWindow.Tab.General}">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.LanguageAndLook}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SettingsWindow.SelectedLanguage}" Margin="5, 0, 15, 0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="150" Margin="0, 0, 0, 5" SelectedItem="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ItemsSource="{Binding AvailableLangauges}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc SettingsWindow.Theme}" Margin="5, 0, 15, 0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="150" Margin="0, 0, 0, 5" SelectedItem="{Binding CurrentTheme, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ItemsSource="{Binding AvailableThemes}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>
                </Grid>

                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Start}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SettingsWindow.StartMaximised}" Margin="5, 0, 15, 0"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="-1, 0, 0, 5" IsChecked="{Binding StartMaximised, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc SettingsWindow.ShowStartPanel}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.ShowStartPanelTooltip}"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="-1, 0, 0, 5" IsChecked="{Binding ShowStartPanel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Game}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SettingsWindow.SelectedGame}" Margin="5, 0, 15, 0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="150" Margin="0, 0, 0, 5" SelectedItem="{Binding CurrentGame, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ItemsSource="{Binding Games}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc SettingsWindow.LoadGameFileOnStartup}" Margin="5, 0, 15, 0"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="-1, 0, 0, 5" IsChecked="{Binding LoadCaPacksByDefault, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2" Text="{loc:Loc SettingsWindow.ShowCaWems}" Margin="5, 0, 15, 0"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="-1, 0, 0, 5" IsChecked="{Binding ShowCAWemFiles, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Controls}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{loc:Loc SettingsWindow.CameraMode}" Margin="5, 0, 15, 0"/>
                    <ComboBox Grid.Column="1" Width="150" Margin="0, 0, 0, 5" SelectedItem="{Binding SelectedCameraMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ItemsSource="{Binding CameraModes}"/>
                </Grid>
            </StackPanel>
        </TabItem>

        <TabItem Header="{loc:Loc SettingsWindow.Rendering}">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Viewport}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SettingsWindow.RenderBackground}" Margin="5, 0, 15, 0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="150" Margin="0, 0, 0, 5" SelectedItem="{Binding CurrentRenderEngineBackgroundColour, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ItemsSource="{Binding RenderEngineBackgroundColours}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc SettingsWindow.GridSize}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.GridSizeTooltip}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VisualEditorsGridSize, UpdateSourceTrigger=LostFocus}" MaxLength="4" Width="150" Margin="0, 0, 0, 5" HorizontalAlignment="Left" HorizontalContentAlignment="Right"/>
                </Grid>

                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Kitbash}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SettingsWindow.OnlyLoadLod0}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.OnlyLoadLod0Tooltip}"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="-1, 0, 0, 5" IsChecked="{Binding OnlyLoadLod0ForReferenceMeshes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc SettingsWindow.VertexSelectionColour}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.VertexSelectionColourTooltip}"/>
                    <colourpickerbutton:ColourPickerButtonView Grid.Row="1" Grid.Column="1" DataContext="{Binding VertexSelectionColour}" Width="25" Height="25" Margin="0, 0, 0, 5" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </TabItem>

        <TabItem Header="{loc:Loc SettingsWindow.Tab.Saving}">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Autosave}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{loc:Loc SettingsWindow.AutosaveMinutes}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.AutosaveMinutesTooltip}"/>
                    <TextBox Grid.Column="1" Text="{Binding AutosaveMinutes, UpdateSourceTrigger=LostFocus}" MaxLength="4" Width="150" Margin="0, 0, 0, 5" HorizontalAlignment="Left" HorizontalContentAlignment="Right"/>
                </Grid>

                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.Group.Backups}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230" SharedSizeGroup="Label"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc SettingsWindow.BackupBeforeSave}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.BackupBeforeSaveTooltip}"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="-1, 0, 0, 5" IsChecked="{Binding BackupBeforeSave, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc SettingsWindow.BackupsKept}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.BackupsKeptTooltip}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BackupsKept, UpdateSourceTrigger=LostFocus}" MaxLength="4" Width="150" Margin="0, 0, 0, 5" HorizontalAlignment="Left" HorizontalContentAlignment="Right"/>

                    <!-- Empty is the default folder, shown as the hint. -->
                    <TextBlock Grid.Row="2" Text="{loc:Loc SettingsWindow.BackupFolder}" Margin="5, 0, 15, 0" ToolTip="{loc:Loc SettingsWindow.BackupFolderTooltip}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource HintedTextBox}" Text="{Binding BackupFolder, UpdateSourceTrigger=LostFocus}"
                             Tag="{Binding DefaultBackupFolder}" Width="400" Margin="0, 0, 0, 5" Padding="2.5, 0, 0, 0"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="..." Command="{Binding BrowseBackupFolderCommand}" Margin="5, 0, 5, 5"/>
                </Grid>
            </StackPanel>
        </TabItem>

        <TabItem Header="{loc:Loc SettingsWindow.Tab.GameFolders}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupTitle}" Text="{loc:Loc SettingsWindow.GameFiles}"/>
                <Separator Style="{StaticResource GroupLine}"/>
                <ItemsControl ItemsSource="{Binding GameDirectores}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0, 0, 0, 5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="600"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding GameName}" Margin="5, 0, 15, 0"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource HintedTextBox}"
                                         Text="{Binding Path}"
                                         Tag="{loc:Loc SettingsWindow.GameDataPathHint}"
                                         IsReadOnly="True"
                                         Padding="2.5, 0, 0, 0"/>
                                <Button Grid.Column="2" Content="..." Command="{Binding BrowseCommand}" Margin="5, 0, 5, 0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
