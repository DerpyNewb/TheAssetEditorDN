<UserControl x:Class="Editors.KitbasherEditor.ChildEditors.SaveDialog.SaveCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="600">
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button MinWidth="90" Margin="3" Content="{loc:Loc KitbashTool.SaveCheck.SaveAnyway}" Command="{Binding ConfirmSaveCommand}"
                    AutomationProperties.AutomationId="SaveCheckSaveAnyway"
                    Visibility="{Binding IsForSave, Converter={StaticResource BoolToCollapsedConverter}}"/>
            <Button MinWidth="90" Margin="3" Content="{loc:Loc KitbashTool.SaveCheck.Cancel}" Command="{Binding CloseCommand}" IsCancel="True"
                    AutomationProperties.AutomationId="SaveCheckCancel"
                    Visibility="{Binding IsForSave, Converter={StaticResource BoolToCollapsedConverter}}"/>
            <Button MinWidth="90" Margin="3" Content="{loc:Loc KitbashTool.SaveCheck.CheckAgain}" Command="{Binding RefreshCommand}"
                    ToolTip="{loc:Loc KitbashTool.SaveCheck.CheckAgainTooltip}"
                    AutomationProperties.AutomationId="SaveCheckAgain"
                    Visibility="{Binding IsForCheck, Converter={StaticResource BoolToCollapsedConverter}}"/>
            <Button MinWidth="90" Margin="3" Content="{loc:Loc KitbashTool.SaveCheck.Close}" Command="{Binding CloseCommand}"
                    AutomationProperties.AutomationId="SaveCheckClose"
                    Visibility="{Binding IsForCheck, Converter={StaticResource BoolToCollapsedConverter}}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="3,0,3,6" TextWrapping="Wrap" Text="{loc:Loc KitbashTool.SaveCheck.SaveHeader}"
                   Visibility="{Binding IsForSave, Converter={StaticResource BoolToCollapsedConverter}}"/>
        <TextBlock DockPanel.Dock="Top" Margin="3,0,3,6" Text="{loc:Loc KitbashTool.SaveCheck.NothingFound}" AutomationProperties.AutomationId="SaveCheckNothingFound"
                   Visibility="{Binding NothingFound, Converter={StaticResource BoolToCollapsedConverter}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Problems}" AutomationProperties.AutomationId="SaveCheckProblems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3,3,3,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" TextWrapping="Wrap">
                                    <Run Text="{Binding Problem.ErrorType, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Problem.ItemName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Problem.Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Top"
                                    Content="{Binding FixLabel}" ToolTip="{Binding FixToolTip}" Command="{Binding Fix}"
                                    AutomationProperties.AutomationId="SaveCheckFix"
                                    Visibility="{Binding HasFix, Converter={StaticResource BoolToCollapsedConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
