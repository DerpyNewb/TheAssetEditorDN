<UserControl x:Class="Editors.UnitSimulator.Views.BakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The simulator's Bake pane; its DataContext is the RiderBakePanel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Moves the rider's table from the mount its clips were made on to the mount loaded here. The rider keeps every move he makes in the saddle; only the mount under him changes."/>

            <TextBlock Text="Made on (the rider table's mount)"/>
            <ComboBox ItemsSource="{Binding SourceTables}" SelectedItem="{Binding Source}" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,0,4"/>
            <TextBlock Text="Seated over this bone of that mount"/>
            <ComboBox ItemsSource="{Binding SourceBones}" SelectedItem="{Binding SourceBone}" Margin="0,0,0,10"/>

            <TextBlock Text="On this mount, follow this bone"/>
            <ComboBox ItemsSource="{Binding TargetBones}" SelectedItem="{Binding TargetBone}" Margin="0,0,0,4"/>
            <CheckBox Content="Follow the picked vertex instead" IsChecked="{Binding SeatOnVertex}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Pick vertex" Command="{Binding PickVertexCommand}" Padding="8,2" Margin="0,0,6,0"
                        ToolTip="Puts the mount's body mesh into vertex picking. Click a vertex in the 3D view, then Use picked vertex."/>
                <Button Content="Use picked vertex" Command="{Binding UsePickedVertexCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding VertexText}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Offset in the mount's bind pose: metres, then degrees" Margin="0,6,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="X" Width="36" VerticalAlignment="Center"/>
                <TextBox Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0"/>
                <TextBlock Text="Y" Width="36" VerticalAlignment="Center"/>
                <TextBox Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0"/>
                <TextBlock Text="Z" Width="36" VerticalAlignment="Center"/>
                <TextBox Text="{Binding OffsetZ, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Yaw" Width="36" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Yaw, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0"/>
                <TextBlock Text="Pitch" Width="36" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Pitch, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0"/>
                <TextBlock Text="Roll" Width="36" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Roll, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </StackPanel>

            <CheckBox Content="Preview: the rider plays the bake of the slot on show" IsChecked="{Binding Preview}" Margin="0,0,0,10"/>

            <TextBlock Text="New table name"/>
            <TextBox Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
            <Button Content="Bake all rider slots and save" Command="{Binding BakeAllCommand}" HorizontalAlignment="Left" Padding="8,2"
                    ToolTip="Writes a clip per baked slot and a copy of the rider's table naming them into your editable pack. Copy-only slots and slots the mount lacks keep their clips."/>
            <TextBlock Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,6,0,4" Text="{Binding Status}"/>
            <ItemsControl ItemsSource="{Binding Report}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
