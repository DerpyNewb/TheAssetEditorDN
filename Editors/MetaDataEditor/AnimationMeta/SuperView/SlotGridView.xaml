<UserControl x:Class="Editors.AnimationMeta.SuperView.SlotGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:conv="clr-namespace:Shared.Ui.Common.ValueConverters;assembly=Shared.Ui">
    <!-- SuperView's slot grid; its DataContext is the SlotGridViewModel. Picking a row picks its slot; an edit plays at once and
         stays unsaved until Save (Ctrl+S). Ctrl+Z and Ctrl+Y take an edit back and forward when the grid has focus. -->
    <UserControl.Resources>
        <conv:FileNameConverter x:Key="FileName"/>
        <Style x:Key="EditedRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Blend, weight and weapons are a battle table's; a campaign set's rows hold files only. -->
        <Style x:Key="BattleOnly" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.IsBattleTable, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2">
            <Button DockPanel.Dock="Left" Content="{loc:Loc SuperView.SlotGrid.Undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Padding="8,1" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="{loc:Loc SuperView.SlotGrid.Redo}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Padding="8,1" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="{loc:Loc SuperView.SlotGrid.Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding HasUnsavedChanges}"
                    ToolTip="{loc:Loc SuperView.SlotGrid.Save.Tooltip}" Padding="8,1" Margin="0,0,4,0"/>
            <Button DockPanel.Dock="Left" Content="{loc:Loc SuperView.SlotGrid.FullGrid}" Command="{Binding OpenFullGridCommand}"
                    ToolTip="{loc:Loc SuperView.SlotGrid.FullGrid.Tooltip}" Padding="8,1" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Status}" Foreground="OrangeRed" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Status}" AutomationProperties.AutomationId="SlotGridStatus"/>
        </DockPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionMode="Single"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" RowStyle="{StaticResource EditedRow}" EnableRowVirtualization="True"
                  PreviewKeyDown="OnPreviewKeyDown" SelectionChanged="OnSelectionChanged" ToolTip="{loc:Loc SuperView.SlotGrid.Tooltip}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc SuperView.SlotGrid.Slot}" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                <!-- Paths show their file name, as in the full bin grid, which is what tells one clip from another; the whole path is
                     on hover and in the cell being edited. -->
                <DataGridTemplateColumn Header="{loc:Loc SuperView.SlotFiles.Animation}" Width="1.3*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Animation, Converter={StaticResource FileName}}" ToolTip="{Binding Animation}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Animation, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Loc SuperView.SlotFiles.Meta}" Width="1.1*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Meta, Converter={StaticResource FileName}}" ToolTip="{Binding Meta}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Meta, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc SuperView.SlotGrid.MetaSource}" Binding="{Binding MetaSource, Mode=OneWay}" IsReadOnly="True" Width="140"/>
                <DataGridTemplateColumn Header="{loc:Loc SuperView.SlotFiles.Sound}" Width="*" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Sound, Converter={StaticResource FileName}}" ToolTip="{Binding Sound}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Sound, UpdateSourceTrigger=LostFocus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="128" CellStyle="{StaticResource BattleOnly}">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal" ToolTip="{loc:Loc SuperView.SlotGrid.Weapons}" AutomationProperties.Name="Weapons">
                            <TextBlock Text="0" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="1" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="2" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="3" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="4" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="5" Width="20" TextAlignment="Center"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Width="20" IsChecked="{Binding Weapon0, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="be_prop_0"/>
                                <CheckBox Width="20" IsChecked="{Binding Weapon1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="be_prop_1"/>
                                <CheckBox Width="20" IsChecked="{Binding Weapon2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="be_prop_2"/>
                                <CheckBox Width="20" IsChecked="{Binding Weapon3, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="be_prop_3"/>
                                <CheckBox Width="20" IsChecked="{Binding Weapon4, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="be_prop_4"/>
                                <CheckBox Width="20" IsChecked="{Binding Weapon5, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="be_prop_5"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc SuperView.SlotGrid.BlendIn}" Binding="{Binding BlendIn}" Width="62" CellStyle="{StaticResource BattleOnly}"/>
                <DataGridTextColumn Header="{loc:Loc SuperView.SlotGrid.Weight}" Binding="{Binding Weight}" Width="58" CellStyle="{StaticResource BattleOnly}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
