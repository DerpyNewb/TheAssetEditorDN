<Window x:Class="Editors.AnimationMeta.Presentation.View.NewMetaDataEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        xmlns:examples="clr-namespace:Editors.AnimationMeta.MetaEditor.Examples"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Title="{loc:Loc MetadataEditor.NewEntryWindow.Title}" Height="860" Width="560"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=FilterBox}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0,0,0,5"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc MetadataEditor.NewEntryWindow.FilterTooltip}"/>

        <!-- A version vanilla WH3 never uses is dimmed: most of those are formats from older games. -->
        <ListView Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Warhammer3Uses}" Value="0">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:Loc MetadataEditor.NewEntryWindow.TagColumn}" DisplayMemberBinding="{Binding Key}" Width="300"/>
                    <GridViewColumn Header="{loc:Loc MetadataEditor.NewEntryWindow.Warhammer3Column}" DisplayMemberBinding="{Binding Warhammer3Uses}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="2" Margin="0,5" MinHeight="48" TextWrapping="Wrap" Text="{Binding SelectedItem.Description}"/>

        <examples:VanillaExamplesView Grid.Row="3" Margin="0,0,0,5" DataContext="{Binding Examples}"
                                      UseLabel="{loc:Loc MetadataEditor.Examples.Insert}" UseToolTip="{loc:Loc MetadataEditor.Examples.Insert.Tooltip}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc MetadataEditor.NewEntryWindow.Ok}" Width="90" Margin="0,0,10,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="{loc:Loc MetadataEditor.NewEntryWindow.Cancel}" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
