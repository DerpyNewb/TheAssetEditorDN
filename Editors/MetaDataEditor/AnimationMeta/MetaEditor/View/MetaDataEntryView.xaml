<UserControl x:Class="Editors.AnimationMeta.Presentation.View.MetaDataEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:view="clr-namespace:Editors.AnimationMeta.Presentation.View"
             mc:Ignorable="d" 
             xmlns:s="http://schemas.singulink.com/xaml"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HasPlayerToVisibility"/>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" >
            <TextBlock Grid.Row="0" FontSize="20" DockPanel.Dock="Left" Text="{loc:Loc MetadataEditor.Entry.HeaderPrefix}"/>
            <TextBlock Grid.Row="0" FontSize="20" DockPanel.Dock="Left" Text="{Binding MetaDataFileVersion, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="0" FontSize="20" DockPanel.Dock="Left" Text="{loc:Loc MetadataEditor.Entry.HeaderSuffix}"/>
        </DockPanel>
   

        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".5*"/>
                <ColumnDefinition Width=".5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="{loc:Loc MetadataEditor.Buttons.New}"  Margin="5,5,5,0"  Command="{Binding NewActionCommand}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="{loc:Loc MetadataEditor.Buttons.Delete}"  Margin="5,5,5,0"  Command="{Binding DeleteActionCommand}"/>

            <Button Grid.Row="1" Grid.Column="0" Content="{loc:Loc MetadataEditor.Buttons.Up}"  Margin="5,5,5,0"  Command="{Binding MoveUpActionCommand}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="{loc:Loc MetadataEditor.Buttons.Down}"  Margin="5,5,5,0"  Command="{Binding MoveDownActionCommand}"/>

            <Button Grid.Row="2" Grid.Column="0" Content="{loc:Loc MetadataEditor.Buttons.Copy}"  Margin="5,5,5,0" Command="{Binding CopyActionCommand}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="{loc:Loc MetadataEditor.Buttons.Paste}"  Margin="5,5,5,0" Command="{Binding PasteActionCommand}"/>

            <Button Grid.Row="3" Grid.Column="0" Content="{loc:Loc MetadataEditor.Buttons.Undo}" ToolTip="Ctrl+Z" Margin="5,5,5,0" Command="{Binding UndoCommand}"/>
            <Button Grid.Row="3" Grid.Column="1" Content="{loc:Loc MetadataEditor.Buttons.Redo}" ToolTip="Ctrl+Y" Margin="5,5,5,0" Command="{Binding RedoCommand}"/>

            <Button Grid.Row="4" Grid.ColumnSpan="2" Content="{loc:Loc MetadataEditor.Buttons.Save}"  Margin="5,5,5,0"  Command="{Binding SaveActionCommand}"/>
        </Grid>

        <!-- Only where there is a player to read the time from: SuperView. -->
        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Visibility="{Binding HasPlayer, Converter={StaticResource HasPlayerToVisibility}}">
            <Button Content="{loc:Loc MetadataEditor.Buttons.SetStartToNow}" ToolTip="{loc:Loc MetadataEditor.Buttons.SetStartToNow.Tooltip}" Margin="5,5,5,0"
                    Command="{Binding SetStartToNowCommand}" AutomationProperties.AutomationId="MetaSetStartToNow"/>
            <Button Content="{loc:Loc MetadataEditor.Buttons.SetEndToNow}" ToolTip="{loc:Loc MetadataEditor.Buttons.SetEndToNow.Tooltip}" Margin="5,5,5,0"
                    Command="{Binding SetEndToNowCommand}" AutomationProperties.AutomationId="MetaSetEndToNow"/>
        </UniformGrid>

        <ListView DockPanel.Dock="Bottom"
            Grid.Row="1" 
            ItemsSource="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" 
            SelectedItem="{Binding SelectedTag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <view:SuperViewMarkView DataContext="{Binding SuperViewMark}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDecodedCorrectly}" Value="false">
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        
    </DockPanel>
</UserControl>
