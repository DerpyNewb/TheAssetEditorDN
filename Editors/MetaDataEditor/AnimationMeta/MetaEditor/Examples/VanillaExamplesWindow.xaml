<Window x:Class="Editors.AnimationMeta.MetaEditor.Examples.VanillaExamplesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        xmlns:examples="clr-namespace:Editors.AnimationMeta.MetaEditor.Examples"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Height="360" Width="560"
        WindowStartupLocation="CenterOwner">
    <examples:VanillaExamplesView Margin="5" UseLabel="{loc:Loc MetadataEditor.Examples.CopyInto}" UseToolTip="{loc:Loc MetadataEditor.Examples.CopyInto.Tooltip}"/>
</Window>
