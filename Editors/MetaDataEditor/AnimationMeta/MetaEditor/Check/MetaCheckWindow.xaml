<Window x:Class="Editors.AnimationMeta.MetaEditor.Check.MetaCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
        mc:Ignorable="d"
        Style="{StaticResource CustomWindowStyle}"
        Title="{Binding Title}" Height="420" Width="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="5">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,5" TextWrapping="Wrap" Text="{Binding Summary}"
                   AutomationProperties.AutomationId="MetaCheckSummary"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
            <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Padding="10,2" Content="{loc:Loc MetadataEditor.Check.Again}"
                    Command="{Binding CheckAgainCommand}" AutomationProperties.AutomationId="MetaCheckAgain"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Text="{Binding Skipped}" AutomationProperties.AutomationId="MetaCheckSkipped"/>
        </DockPanel>
        <!-- A message is a sentence or three, so it wraps in its column rather than running off the window. -->
        <ListView ItemsSource="{Binding Problems}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="MetaCheckProblems">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="36"/>
                    <GridViewColumn Header="{loc:Loc MetadataEditor.Check.TagColumn}" DisplayMemberBinding="{Binding TagName}" Width="150"/>
                    <GridViewColumn Header="{loc:Loc MetadataEditor.Check.SeverityColumn}" DisplayMemberBinding="{Binding Severity}" Width="70"/>
                    <GridViewColumn Header="{loc:Loc MetadataEditor.Check.ProblemColumn}" Width="460">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
