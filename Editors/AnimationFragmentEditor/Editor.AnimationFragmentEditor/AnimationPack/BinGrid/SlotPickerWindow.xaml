<Window x:Class="Editors.AnimationFragmentEditor.AnimationPack.BinGrid.SlotPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a slot"
        Width="380"
        Height="520"
        Style="{StaticResource CustomWindowStyle}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6" PreviewKeyDown="FilterBox_PreviewKeyDown"
                 ToolTip="Type part of a slot name. Enter picks the highlighted slot, or the first one that is free."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Greyed slots are already in this table." Foreground="{DynamicResource ABrush.Foreground.Disabled}" Margin="0,6,0,0"/>
        <ListBox x:Name="SlotList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="SlotList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsEnabled" Value="{Binding IsFree}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
